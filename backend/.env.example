# Not used directly by Docker Compose (which reads the root .env), but handy for
# running the backend standalone with `npm run dev` against a local Postgres.
DATABASE_URL=postgresql://myleadsmap:changeme@localhost:5432/myleadsmap
JWT_SECRET=changeme_use_a_long_random_string
GOOGLE_MAPS_API_KEY=
CORS_ORIGIN=*
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=changeme_use_a_strong_password
PORT=3001
