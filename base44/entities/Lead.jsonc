{
  "name": "Lead",
  "type": "object",
  "properties": {
    "place_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "pipeline_stage": {
      "type": "string",
      "enum": [
        "prospect",
        "pitched",
        "following_up",
        "closed",
        "open"
      ],
      "default": "prospect"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "last_action_type": {
      "type": "string",
      "enum": [
        "called",
        "emailed",
        "spoke_phone",
        "declined"
      ]
    },
    "last_action_date": {
      "type": "string",
      "format": "date"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_type": {
            "type": "string",
            "enum": [
              "called",
              "emailed",
              "spoke_phone",
              "declined"
            ]
          },
          "action_date": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          },
          "pipeline_stage": {
            "type": "string",
            "enum": [
              "prospect",
              "pitched",
              "following_up",
              "closed",
              "open"
            ]
          }
        }
      }
    }
  },
  "required": [
    "place_id",
    "name",
    "lat",
    "lng"
  ]
}