# Copy this file to .env and fill in real values before running `docker compose up`.

# --- Postgres ---
POSTGRES_USER=myleadsmap
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_DB=myleadsmap

# --- Backend ---
# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme_use_a_long_random_string

# Shared Google Maps/Places API key used for premium-plan and admin searches.
# Get one at https://mapsplatform.google.com/maps-demo-key/
GOOGLE_MAPS_API_KEY=

# Origin(s) allowed to call the API. "*" is fine for a Tailscale-only deployment.
CORS_ORIGIN=*

# Bootstrap admin account — created once, automatically, the first time the
# backend starts against an empty database. Change the password after first login.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=changeme_use_a_strong_password

# --- Frontend ---
# Host port the app is served on (http://localhost:FRONTEND_PORT). Not used in production
# (docker-compose.prod.yml stops publishing this port; Caddy fronts the app instead).
FRONTEND_PORT=8080

# --- Production only (docker-compose.prod.yml) ---
# Your real domain, e.g. myleadsmap.com -- Caddy auto-provisions a Let's Encrypt cert for it.
DOMAIN=
